# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Onde encontrar: Supabase > Project Settings > API (ou "Connect" > App Frameworks).

# URL do projeto (ex.: https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=

# Chave pública do projeto: "anon public" ou "publishable key" (começa com sb_publishable_).
# NUNCA use aqui a chave "service_role" / "secret": ela ignora as regras de segurança.
VITE_SUPABASE_ANON_KEY=
